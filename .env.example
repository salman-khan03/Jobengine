# Local Docker demo. Defaults in compose.yml are for localhost only.
POSTGRES_PASSWORD=local-roleradar-only
JOBENGINE_SECRET_KEY=local-development-secret-at-least-32-characters
AUTH_SECRET=local-session-secret-at-least-32-characters

# Unset -> local SQLite file (zero setup). Set to a real Postgres URL to run
# against Neon/Supabase/RDS/etc. — note the +psycopg dialect suffix db.py
# requires; most providers' dashboards give you the URL without it.
DATABASE_URL=

# Optional: select a provider and a currently available model for your account.
# The deterministic decision workflow needs no API key — every entry point in
# llm_client.py returns None (not an exception) with no key, no network, or a
# provider outage, and the whole test suite runs this way in CI.
ROLERADAR_LLM_PROVIDER=
ROLERADAR_LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
# Third supported provider (openrouter.ai) — same interface as the two above.
# Free-tier keys can't reach every model; check GET /api/v1/models for what's
# currently free, and set ROLERADAR_LLM_MODEL explicitly rather than relying
# on the provider default, which targets a paid model.
OPENROUTER_API_KEY=
